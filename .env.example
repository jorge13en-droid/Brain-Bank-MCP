# ---------------------------------------------------------------
# Brain Bank MCP - variaveis de ambiente
# Copie este arquivo para .env e preencha com os seus valores.
#   cp .env.example .env
# ---------------------------------------------------------------

# Onde as memorias sao gravadas.
# Padrao: ~/BrainBank (na sua pasta de usuario, fora do codigo).
BRAIN_BANK_DATA_DIR=

# Tamanho maximo (em KB) de uma unica memoria. Padrao: 512
BRAIN_BANK_MAX_MEMORY_KB=512
