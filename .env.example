# ---------------------------------------------------------------
# Brain Bank MCP - variaveis de ambiente
# Copie este arquivo para .env e preencha com os seus valores.
#   cp .env.example .env
# ---------------------------------------------------------------

# Onde as memorias sao gravadas.
# Opcional: se nao definir, o padrao e a pasta ./data do projeto.
BRAIN_BANK_DATA_DIR=

# Tamanho maximo (em KB) de uma unica memoria. Padrao: 512
BRAIN_BANK_MAX_MEMORY_KB=512
